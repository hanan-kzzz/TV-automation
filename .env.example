# ==============================================================================
# Telegram Bot Configuration for MoneyPrinterTurbo
# ==============================================================================

# Telegram Bot Token from @BotFather (Required)
# Example: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=

# Authorized Telegram Numeric User IDs (Recommended for security)
# Comma-separated list of Telegram User IDs allowed to trigger video generation.
# To find your ID, message @userinfobot or @raw_data_bot on Telegram.
# If left empty, the bot rejects requests and instructs you to set your ID.
# Set to * to allow all users (not recommended for production).
# Example: 123456789,987654321
TELEGRAM_ALLOWED_USER_IDS=

# MoneyPrinterTurbo API Configuration
# Base URL where the MoneyPrinterTurbo FastAPI server is running (default: http://127.0.0.1:8080)
MONEYPRINTER_BASE_URL=http://127.0.0.1:8080

# MoneyPrinterTurbo API Key (Optional)
# Only required if 'api_key' is set under [app] in MoneyPrinterTurbo's config.toml.
# Leave empty if API authentication is disabled in config.toml.
MONEYPRINTER_API_KEY=

# Local directory where generated video tasks are stored
# Defaults to storage/tasks relative to the MoneyPrinterTurbo project root
VIDEO_OUTPUT_DIR=storage/tasks

# Bot Worker & Queue Concurrency Settings
# Maximum concurrent video generation requests sent to MoneyPrinterTurbo
# Keep at 1 or 2 to avoid exhausting CPU/GPU resources on the host machine
MAX_CONCURRENT_JOBS=1

# Job Polling & Timeouts
JOB_POLL_INTERVAL_SECONDS=3
JOB_TIMEOUT_SECONDS=1800
MAX_HTTP_RETRIES=3

# Persistent Storage Directory for Bot (SQLite database for jobs and user preferences)
BOT_STORAGE_DIR=storage/telegram_bot

# Default Video Preferences (can also be customized per-user in Telegram /settings)
# Supported languages: en, ml (Malayalam), manglish, zh, etc.
DEFAULT_LANGUAGE=en
# Supported aspect ratios: 9:16, 16:9, 1:1
DEFAULT_ASPECT_RATIO=9:16
# Narration length: 1 (~15-30s), 2 (~30-60s), 3 (~60-90s)
DEFAULT_PARAGRAPHS=1
# Source clip duration in seconds: 3 (fast), 5 (standard), 8 (relaxed)
DEFAULT_CLIP_DURATION=5
# TTS Voice Name (optional override, otherwise selected based on language)
DEFAULT_VOICE_NAME=

# Scheduled Generation (Disabled by default)
# Set to 'true' to enable scheduled automated video creation
SCHEDULE_ENABLED=false
# Interval in hours between scheduled generations (e.g. 24 for daily)
SCHEDULE_INTERVAL_HOURS=24
# Target Telegram Chat ID where scheduled videos should be sent
SCHEDULE_CHAT_ID=
# Comma-separated topics or prompts for scheduled videos
SCHEDULE_TOPICS=
